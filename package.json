{
  "name": "documentary-video-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:remotion": "remotion studio remotion/entry.tsx --public-dir=remotion/public",
    "build": "npm run build:client",
    "build:client": "vite build --config client/vite.config.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "typecheck:remotion": "tsc -p remotion/tsconfig.json --noEmit",
    "test:royal-v2": "tsx scripts/royal-v2-bulk-smoke.ts",
    "test:royal-v2:long": "tsx scripts/royal-v2-bulk-smoke.ts --long",
    "runpod:ingest-worker": "tsx scripts/runpod-ingest-worker.ts",
    "runpod:worker": "tsx scripts/runpod-render-worker.ts",
    "runpod:serverless:deploy": "tsx scripts/deploy-runpod-serverless.ts",
    "runpod:serverless:smoke": "tsx scripts/smoke-runpod-serverless.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/lib-storage": "^3.1101.0",
    "@remotion/bundler": "^4.0.489",
    "@remotion/cli": "^4.0.489",
    "@remotion/lambda": "4.0.489",
    "@remotion/renderer": "^4.0.489",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.86.2",
    "remotion": "^4.0.489",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
