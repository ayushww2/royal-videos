{
  "timeline": {
    "background": "#000000",
    "tracks": [
      {
        "clips": [
          {
            "asset": {
              "type": "html5",
              "html": "<div class=\"bar\"><div class=\"accent\"></div><div class=\"glow\"></div><div class=\"shine\"></div><div class=\"name\" id=\"name\">{{PRIMARY_TEXT}}</div></div>",
              "css": "html,body{margin:0;padding:0;width:600px;height:112px;overflow:hidden;background:transparent;font-family:system-ui,Arial,sans-serif}.bar{position:relative;width:600px;height:112px;border-radius:0 12px 12px 0;overflow:hidden;background:linear-gradient(100deg,rgba(4,23,67,.96),rgba(16,73,170,.97) 56%,rgba(25,103,235,.98));box-shadow:0 18px 42px rgba(0,0,0,.45);opacity:0;transform:translateX(-52px)}.bar:after{content:'';position:absolute;inset:2px;border:1px solid rgba(255,255,255,.14);border-radius:0 10px 10px 0}.accent{position:absolute;left:0;top:0;bottom:0;width:12px;background:linear-gradient(180deg,#70d6ff,#2c7cff)}.glow{position:absolute;left:-110px;top:-110px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(91,180,255,.34),transparent 68%)}.shine{position:absolute;left:-210px;top:-80px;width:160px;height:300px;transform:skewX(-16deg);background:linear-gradient(90deg,transparent,rgba(255,255,255,.13),transparent)}.name{position:absolute;left:38px;right:28px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;color:white;font-size:44px;font-weight:850;letter-spacing:.5px;text-transform:uppercase;white-space:nowrap;opacity:0;transform:translateX(-10px)}",
              "js": "const n=document.getElementById('name');let s=44;n.style.fontSize=s+'px';while(n.scrollWidth>n.clientWidth&&s>24){s--;n.style.fontSize=s+'px'}const tl=gsap.timeline();tl.to('.bar',{opacity:1,x:0,duration:.48,ease:'power3.out'},0).to('.name',{opacity:1,x:0,duration:.4,ease:'power2.out'},.18).to('.shine',{x:930,duration:1.05,ease:'power2.inOut'},.32).to({}, {duration:2.85}).to('.bar',{opacity:0,x:-24,duration:.35,ease:'power2.in'});"
            },
            "start": 0,
            "length": 5,
            "width": 600,
            "height": 112,
            "fit": "none",
            "offset": {
              "x": -0.31,
              "y": -0.37
            }
          }
        ]
      },
      {
        "clips": [
          {
            "asset": {
              "type": "image",
              "src": "{{BACKGROUND_IMAGE}}"
            },
            "start": 0,
            "length": 5,
            "width": 1920,
            "height": 1080,
            "fit": "crop",
            "position": "center",
            "transition": {
              "in": "fade",
              "out": "fade"
            },
            "effect": "zoomInSlow"
          }
        ]
      }
    ]
  },
  "output": {
    "format": "mp4",
    "resolution": "1080",
    "fps": 25,
    "quality": "high"
  },
  "merge": [
    {
      "find": "PRIMARY_TEXT",
      "replace": "FIELD INVESTIGATION"
    },
    {
      "find": "BACKGROUND_IMAGE",
      "replace": "https://example.com/background.jpg"
    }
  ]
}