{
  "timeline": {
    "background": "#03070c",
    "tracks": [
      {
        "clips": [
          {
            "asset": {
              "type": "html5",
              "html": "<div class=\"stage\"><div class=\"shade\"></div><div class=\"kicker\">THE EVIDENCE REVEALS</div><div class=\"title\" id=\"t\">{{REVEAL_TEXT}}</div><div class=\"rule\"></div><div class=\"pulse\"></div></div>",
              "css": "html,body{margin:0;padding:0;width:1920px;height:1080px;overflow:hidden;background:transparent;font-family:system-ui,Arial,sans-serif}.stage{position:relative;width:1920px;height:1080px}.shade{position:absolute;inset:0;background:radial-gradient(circle at 50% 44%,rgba(20,42,62,.12),rgba(0,3,7,.78) 74%)}.kicker{position:absolute;left:0;right:0;top:350px;text-align:center;color:#6dbbff;font-size:26px;font-weight:800;letter-spacing:7px;opacity:0}.title{position:absolute;left:180px;right:180px;top:410px;height:160px;display:flex;align-items:center;justify-content:center;text-align:center;color:white;font-size:96px;font-weight:950;text-transform:uppercase;text-shadow:0 8px 28px rgba(0,0,0,.55);opacity:0;transform:scale(.95)}.rule{position:absolute;left:705px;top:590px;width:510px;height:7px;border-radius:99px;background:linear-gradient(90deg,#4eaaff,#a8dcff,#4eaaff);opacity:0;transform:scaleX(.1)}.pulse{position:absolute;left:760px;top:300px;width:400px;height:400px;border-radius:50%;border:1px solid rgba(94,176,255,.2);opacity:0}",
              "js": "const tl=gsap.timeline();tl.to('.kicker',{opacity:1,duration:.4},.12).to('#t',{opacity:1,scale:1,duration:.62,ease:'power3.out'},.34).to('.rule',{opacity:1,scaleX:1,duration:.46,ease:'power3.out'},.62).to('.pulse',{opacity:.8,scale:1.6,duration:1.5,ease:'power2.out'},.45).to('.pulse',{opacity:0,duration:.5},1.6);"
            },
            "start": 0,
            "length": 4.5,
            "width": 1920,
            "height": 1080,
            "fit": "none"
          }
        ]
      },
      {
        "clips": [
          {
            "asset": {
              "type": "image",
              "src": "{{BACKGROUND_IMAGE}}"
            },
            "start": 0,
            "length": 4.5,
            "width": 1920,
            "height": 1080,
            "fit": "crop",
            "position": "center",
            "transition": {
              "in": "fade",
              "out": "fade"
            },
            "effect": "zoomOutSlow"
          }
        ]
      }
    ]
  },
  "output": {
    "format": "mp4",
    "resolution": "1080",
    "fps": 25,
    "quality": "high"
  },
  "merge": [
    {
      "find": "REVEAL_TEXT",
      "replace": "THE ORIGINAL RECORDING"
    },
    {
      "find": "BACKGROUND_IMAGE",
      "replace": "https://example.com/background.jpg"
    }
  ]
}