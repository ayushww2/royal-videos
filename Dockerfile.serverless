FROM node:22-bookworm-slim

# FFmpeg + Chromium deps for Remotion + Python for RunPod serverless SDK
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    ffmpeg \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    xdg-utils \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .
RUN npm run build

# Mystery Remotion overlays + intro assets must be in the build context
# (remotion/public/overlays/transitions + remotion/public/intro). R2 fetch from
# GitHub Actions gets 403, so these are committed and verified here.
RUN python3 - <<'PY'
from pathlib import Path
root = Path("/app/remotion/public")
need = [
  "overlays/transitions/film-burn.mp4",
  "overlays/transitions/camera-shutter.mp4",
  "overlays/transitions/transition-glitch.mp4",
  "intro/intro-music.mp3",
  "intro/shot1.jpg",
]
for f in need:
    p = root / f
    assert p.is_file() and p.stat().st_size > 1000, f"missing overlay asset: {f}"
print("overlays ok", (root / "overlays/transitions/film-burn.mp4").stat().st_size)
PY

# Download Chrome headless for Remotion (cached in image)
RUN npx remotion browser ensure || true

# RunPod Python serverless SDK
RUN pip3 install --no-cache-dir --break-system-packages runpod

ENV NODE_ENV=production
ENV PORT=3000
ENV STORAGE_PATH=/app/storage
ENV RENDERER=remotion
ENV REMOTION_LAMBDA=0
ENV RUNPOD_RENDER=0
ENV REMOTION_CONCURRENCY=8

RUN mkdir -p /app/storage /app/data

# Serverless workers must run the handler (not the Express app)
CMD ["python3", "-u", "serverless/handler.py"]
