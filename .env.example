OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.contactboxtools.me/v1
OPENAI_MODEL=gpt-5.5
# Celebrity v1 permanent reference-edit defaults (Tp5kwT3785Y pacing/raw%/LT/zoom).
# Defaults ON after user approval — every new Celebrity job uses the recipe automatically.
# Set false/0/off only to disable. See server/visualIntelligence/celebrityV1/REFERENCE_RECIPE.md
CELEBRITY_V1_REFERENCE_EDIT=true
# AI Knowledge Editor chat (Job Status / Timeline / Scene Review). Falls back to OPENAI_MODEL.
KNOWLEDGE_EDITOR_MODEL=gpt-5.6
# EDITOR_CHAT_MODEL=gpt-5.6
# VO↔script beat timing (Royal v2). Uses Whisper word timestamps via API.
# Local Whisper is not used on Railway (no GPU / slim image) — API only.
# If your chat proxy lacks /audio/transcriptions, set OPENAI_WHISPER_BASE_URL
# to https://api.openai.com/v1 (same OPENAI_API_KEY must work there).
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_WHISPER_BASE_URL=https://api.openai.com/v1
# Optional dedicated Whisper key (falls back to OPENAI_API_KEY). Use real OpenAI if ContactBox lacks /audio.
OPENAI_WHISPER_API_KEY=
# Set to false to keep legacy WPM stretch timing even when VO is uploaded
VOICE_ALIGNMENT=true
# GPT Image 2 stills (real OpenAI only — NOT ContactBox). 16:9 landscape, low quality default.
# Do not reuse ContactBox OPENAI_API_KEY here.
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=low
# Mystery v2 AI still realism (ContactBox prompt → OpenAI Image). Landscape only.
# MYSTERY_V2_IMAGE_MODEL=gpt-image-2
# MYSTERY_V2_IMAGE_SIZE=1536x1024
# Google Images via SearchAPI (candidate collection + AI editor /api/jobs/:jobId/editor/web-search)
SEARCHAPI_API_KEY=
# Final MP4 renderer: shotstack (Mystery v2 primary / sandbox) | remotion | remotion-lambda | runpod
RENDERER=shotstack
# Or keep RENDERER=remotion and set REMOTION_LAMBDA=1 to use AWS Remotion Lambda
REMOTION_LAMBDA=0
# Or set RUNPOD_RENDER=1 / RENDERER=runpod for on-demand RunPod (see RUNPOD.md)
RUNPOD_RENDER=0
REMOTION_CONCURRENCY=1

# Remotion Lambda (AWS) — used when REMOTION_LAMBDA=1 or RENDERER=remotion-lambda
# IAM user needs Remotion's user policy (or AdministratorAccess) + remotion-lambda-role.
# Deploy: npx remotion lambda functions deploy --memory 2048 --disk 2048 --timeout 240
# Site:   npx remotion lambda sites create remotion/entry.tsx --site-name=documentary-factory
# Media in inputProps must be public HTTPS (R2_PUBLIC_URL or PUBLIC_APP_URL signed routes).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
REMOTION_AWS_REGION=us-east-1
# Filled after deploy (function name like remotion-render-4-0-489-mem2048mb-disk2048mb-240sec)
REMOTION_FUNCTION_NAME=
# Serve URL from `npx remotion lambda sites create` / sites ls
REMOTION_SERVE_URL=
REMOTION_SITE_NAME=documentary-factory

# On-demand RunPod Remotion (RENDERER=runpod). Prefer Serverless when endpoint set.
# See RUNPOD_SERVERLESS.md (ASAP) and RUNPOD.md (Pod fallback).
RUNPOD_API_KEY=
RUNPOD_WORKER_SECRET=
# Prefer Serverless (RTX 3090, workersMin=0 scale-to-zero, max 1; warm=1 costs ~$0.68/hr):
RUNPOD_SERVERLESS_ENDPOINT_ID=
# Optional image override for deploy script:
# RUNPOD_SERVERLESS_IMAGE=ghcr.io/ayushww2/new-video-ai-remotion-serverless:latest
# Pod fallback when serverless unset (auto start on render, auto stop when idle):
RUNPOD_POD_ID=
# Fallback: create from template if pod missing/terminated
RUNPOD_TEMPLATE_ID=
RUNPOD_VOLUME_ID=
RUNPOD_POD_NAME=documentary-remotion-worker
RUNPOD_GPU_TYPE=NVIDIA GeForce RTX 4090
RUNPOD_GPU_COUNT=1
# RUNPOD_COMPUTE_TYPE=CPU
# RUNPOD_CPU_FLAVOR=cpu3g
RUNPOD_CLOUD_TYPE=SECURE
RUNPOD_IDLE_STOP_MINUTES=10
RUNPOD_REMOTION_CONCURRENCY=8
# Optional override when creating from template (else use template start command):
# RUNPOD_DOCKER_START_CMD=cd /workspace/documentary-video-factory && npm run runpod:worker
# On the pod template also set: APP_BASE_URL=<PUBLIC_APP_URL>, STORAGE_PATH=/workspace/storage

SHOTSTACK_API_KEY=
SHOTSTACK_API_URL=https://api.shotstack.io/edit/stage/render
# ElevenLabs TTS (voiceover generation)
ELEVENLABS_API_KEY=
# Defaults: Bill (Social Media) + Turbo v2.5
ELEVENLABS_VOICE_ID=pqHfZKP75CvOlQylNhV4
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
PUBLIC_APP_URL=
PEXELS_API_KEY=
# Free Pixabay API (images + videos). https://pixabay.com/api/docs/
PIXABAY_API_KEY=
STORAGE_PATH=./storage
PORT=3000
NODE_ENV=development

# R2 — Royal media library + final RunPod MP4 playback
# When configured, completed RunPod renders upload to r2://$R2_BUCKET/renders/<jobId>/final.mp4
# and job.render.outputUrl uses R2_PUBLIC_URL (falls back to /media/... locally if R2 missing).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
# Max parallel visual-intelligence jobs (all niches). Clamp 1–6. Default 4 (Railway Pro).
# Submit 5–6 at once — extras wait in queue instead of stampeding OpenAI/Railway.
PIPELINE_WORKER_CONCURRENCY=4
# Legacy alias (used only if PIPELINE_WORKER_CONCURRENCY unset)
ROYAL_V2_WORKER_CONCURRENCY=4
# Max parallel Whisper uploads (default 1)
WHISPER_CONCURRENCY=1

# Optional YouTube raw ingest (cloud worker — not the PC UI host)
# Shared secret for /api/raw-ingest/* worker routes
RUNPOD_WORKER_SECRET=
# Optional alias if you prefer a dedicated secret name
RAW_INGEST_WORKER_SECRET=
# Wake a stopped RunPod ingest pod when a job is queued
RUNPOD_API_KEY=
RUNPOD_INGEST_POD_ID=
# Worker → app base URL (Railway / PUBLIC_APP_URL)
APP_BASE_URL=
# Netscape cookies.txt on the pod volume (required for reliable YT downloads)
YT_COOKIES_PATH=/workspace/secrets/youtube-cookies.txt
# Often required from datacenter IPs
YTDLP_PROXY=
RAW_INGEST_POLL_MS=5000
RAW_INGEST_IDLE_STOP_MS=600000

# RunPod final renders (see RUNPOD.md): set RENDERER=runpod or RUNPOD_RENDER=1 above.
# Required for "Render on RunPod" on Job Status: RUNPOD_API_KEY, RUNPOD_WORKER_SECRET,
# and RUNPOD_POD_ID (preferred) or RUNPOD_TEMPLATE_ID.
# Prefer a stopped reusable pod: RUNPOD_POD_ID=

# Royal v2 scene-change SFX (international doc bed under VO). Default ON.
# Soft whooshes rotate on every scene change; GPT accents (press/archive/legal) are spaced.
# Requires reprocess + remotion/runpod render to hear in finished video.
ROYAL_SFX=true
ROYAL_SFX_MODEL=gpt-5.6

# Royal v2 background music (sparse beds under VO, max 3 tracks). Default ON.
# GPT picks mood-matched pieces from remotion/public/music/royal/; fade in/out; duck under dense VO.
# Requires reprocess + remotion/runpod render to hear in finished video.
ROYAL_BG_MUSIC=true
ROYAL_BG_MUSIC_MODEL=gpt-5.6

# Royal v2 sparse glitch overlays (~0.75s mp4 + ducked audio, screen blend).
# Default OFF — free YouTube-style pack; use only for rare chapter/crisis/reveal cuts.
# Assets: remotion/public/overlays/glitch/ (see manifest.json). Max ~4/video, ≥55s apart.
# Requires reprocess + remotion/runpod render to see/hear in finished video.
ROYAL_GLITCH=false

# Optional cost modes
# PIPELINE_EFFICIENT=true samples soft approval (~20% person beats) and skips some GPT steps.
# Keep false for good visual intelligence / validation reprocess runs.
PIPELINE_EFFICIENT=false
PIPELINE_CHEAP=false

# Soft scene approval (Royal v2): AI checks correct person vs beat/narration.
# Default ON + FULL check of all person/pair beats (when PIPELINE_EFFICIENT=false).
# Vision used when media URL is public HTTPS (R2_PUBLIC_URL); else text labels.
# Soft fails trigger 1–2 library re-pick rounds, then re-check.
# Does not hard-block render. Fails stay pending in Scene Review.
SOFT_APPROVAL=true
# When fail rate among checked scenes >= threshold, also hold unsure scenes from auto-approve
SOFT_APPROVAL_BLOCK=false
SOFT_APPROVAL_FAIL_RATE=0.25
SOFT_APPROVAL_CONCURRENCY=3
SOFT_APPROVAL_BATCH_SIZE=4
SOFT_APPROVAL_CONFIDENCE_THRESHOLD=0.7
# Optional cheaper/faster model for soft checks (falls back to OPENAI_MODEL)
# SOFT_APPROVAL_MODEL=gpt-5.5
